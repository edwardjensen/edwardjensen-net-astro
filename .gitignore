# Standard Node and macOS files
node_modules/
.DS_Store
*.code-workspace

# Astro build output
dist/
.astro/

# Wrangler local dev state
.wrangler/

# Environment and secrets
.env
.env.*
!.env.example
# Content-source mode templates (docs/environment.md): URLs only, never keys. Keys go in the
# matching .env.<mode>.local, which stays ignored.
!.env.production-relay
!.env.staging-relay
!.env.staging-direct
!.env.local-cms
.dev.vars
docs/github-secrets.txt

# CI-generated files (written by GitHub Actions workflows before npm run build)
# src/data/buildinfo.ts is committed as a local dev fallback; CI overwrites it.
# Do not commit the CI-generated version.

# hi-redirector config — fetched from CMS at deploy time (not committed)
cloudflare-workers/hi-redirector/hi-redirects.json

# Contexts (planning docs)
contexts
.claude
logs/*