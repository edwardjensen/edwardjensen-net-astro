# Environment variables for local development.
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must never be committed.

# Base URL of the Cloudflare KV content relay (no trailing slash, no /v2).
# The /v2 path is appended automatically by the API client.
# Production relay: https://contentrelay.edwardjensen.net
CONTENT_RELAY_URL=https://contentrelay.edwardjensen.net

# Read API key for the content relay (X-Read-Key header).
# Required for all relay reads. Set via wrangler secret on the relay worker.
CONTENT_RELAY_READ_KEY=

# To read a different source (the staging relay, a CMS directly, a CMS on this machine), run a
# content-source mode instead of editing this file: npm run dev:staging-relay, dev:staging-direct
# or dev:local-cms. Their settings live in .env.<mode> and the git-ignored .env.<mode>.local
# (docs/environment.md). npm run check:source validates the configured source.

# Optional: render the contact form on the per-event pages (/hi/{tag}/). Both are public (they
# end up in the built pages). Without them the pages still build, just without forms.
# The intake service's submit URL (https, or http://localhost for local development).
PUBLIC_INTAKE_SUBMIT_URL=
# The hCaptcha sitekey. hCaptcha publishes a test sitekey that works locally.
PUBLIC_HCAPTCHA_SITEKEY=
