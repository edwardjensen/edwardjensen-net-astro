---
/**
 * /hi landing page — "Let's Connect"
 * Uses the LandingPage layout; the sections below the intro are shared with the per-event
 * pages (/hi/{tag}/, see hi/[tag].astro) through HiSections.
 */
import LandingPage from "../layouts/LandingPage.astro";
import HiSections from "../components/sections/HiSections.astro";
import { copy } from "../data/copy";
---

<LandingPage
  title={copy.hi.metaTitle}
  description={copy.hi.metaDescription}
  image="/assets/images/bluebackground.png"
>
  <!-- Intro prose -->
  <Fragment>
    <h1>{copy.hi.heading}</h1>
    <p>
      {copy.hi.introPrefix}{" "}
      <a href="https://www.meda.net/">MEDA, the Metropolitan Economic Development Association</a>,{" "}
      {copy.hi.introSuffix}
    </p>
    <p>{copy.hi.intro2}</p>
  </Fragment>

  <Fragment slot="sections">
    <HiSections />
  </Fragment>
</LandingPage>
