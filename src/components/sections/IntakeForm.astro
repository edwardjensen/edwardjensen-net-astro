---
/**
 * The per-event intake form on /hi/{tag}/.
 *
 * Renders only the fields the event's share token asks for (see src/lib/intake.ts), and
 * posts them in the background to the intake service, so the visitor keeps what they typed
 * if something goes wrong and sees the thanks in place. The service does the real checks:
 * the token, hCaptcha, and which websites may submit.
 *
 * hCaptcha is loaded here, so only pages with a form pay for it. It needs JavaScript, so
 * there is no no-script fallback beyond a notice.
 */
import { copy } from "../../data/copy";
import { NAME_MAX_LENGTH, type FieldDef } from "../../lib/intake";

interface Props {
  /** The event's signed share token, sent back as `t`. */
  token: string;
  fields: FieldDef[];
  submitUrl: string;
  sitekey: string;
}

const { token, fields, submitUrl, sitekey } = Astro.props;
const text = copy.hi.intake;
const inputClass = "input-default";
---

<div data-intake>
  <form
    method="post"
    action={submitUrl}
    class="space-y-5 text-left"
    data-intake-form
    data-errors={JSON.stringify(text.errors)}
    data-sending={text.sending}
    data-submit={text.submit}
  >
    <input type="hidden" name="t" value={token} />

    <!-- Honeypot: people never see this, so anything in it is a bot. -->
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label>
        {text.honeypotLabel}
        <input type="text" name="nickname" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <p>
      <label for="intake-name" class="block font-semibold mb-1">
        {text.nameLabel} <span class="font-normal text-muted">{text.required}</span>
      </label>
      <input
        class={inputClass}
        id="intake-name"
        name="name"
        type="text"
        required
        maxlength={NAME_MAX_LENGTH}
        autocomplete="name"
      />
    </p>

    {fields.map((field) => (
      <p>
        <label for={`intake-${field.key}`} class="block font-semibold mb-1">{field.label}</label>
        {field.control === "textarea" ? (
          <textarea
            class={inputClass}
            id={`intake-${field.key}`}
            name={field.key}
            rows={field.rows}
            maxlength={field.maxlength}
          />
        ) : (
          <input
            class={inputClass}
            id={`intake-${field.key}`}
            name={field.key}
            type={field.type}
            maxlength={field.maxlength}
            autocomplete={field.autocomplete}
            inputmode={field.inputmode}
            autocapitalize={field.key === "website" ? "none" : undefined}
            spellcheck={field.key === "website" ? false : undefined}
          />
        )}
      </p>
    ))}

    <div class="h-captcha" data-sitekey={sitekey}></div>
    <noscript><p class="text-muted">{text.noscript}</p></noscript>

    <p role="alert" class="font-semibold text-brand-chestnut dark:text-brand-orange" data-intake-error></p>

    <p><button type="submit" class="btn-primary">{text.submit}</button></p>
  </form>

  <div class="text-center" data-intake-thanks hidden tabindex="-1" role="status">
    <h3 class="font-header font-bold text-2xl text-heading mb-2">{text.thanksHeading}</h3>
    <p class="text-xl">{text.thanks}</p>
  </div>
</div>

<script is:inline src="https://js.hcaptcha.com/1/api.js" async defer></script>

<script>
  const root = document.querySelector<HTMLElement>("[data-intake]");
  const form = root?.querySelector<HTMLFormElement>("[data-intake-form]");
  const thanks = root?.querySelector<HTMLElement>("[data-intake-thanks]");
  const errorBox = root?.querySelector<HTMLElement>("[data-intake-error]");
  const button = form?.querySelector<HTMLButtonElement>("button[type=submit]");

  if (form && thanks && errorBox && button) {
    const errors = JSON.parse(form.dataset.errors ?? "{}") as Record<string, string>;
    const sendingLabel = form.dataset.sending ?? "";
    const submitLabel = form.dataset.submit ?? "";

    // hCaptcha adds two response fields without labels. They are display:none, so assistive
    // technology never sees them, but automated checkers (pa11y, the PR gate) flag them. Give
    // them a name as they appear.
    const nameCaptchaFields = () => {
      form
        .querySelectorAll<HTMLTextAreaElement>("textarea[name='h-captcha-response'], textarea[name='g-recaptcha-response']")
        .forEach((field) => field.setAttribute("aria-label", "hCaptcha response"));
    };
    nameCaptchaFields();
    new MutationObserver(nameCaptchaFields).observe(form, { childList: true, subtree: true });

    const fail = (code: string) => {
      errorBox.textContent = errors[code] ?? errors.invalid ?? "";
      // A used hCaptcha response can't be used twice, so ask for a fresh one.
      (window as unknown as { hcaptcha?: { reset: () => void } }).hcaptcha?.reset();
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorBox.textContent = "";
      button.disabled = true;
      button.textContent = sendingLabel;
      try {
        // Cross-origin, but a plain form body, so it needs no preflight. The service only
        // answers websites on its allowlist.
        const response = await fetch(form.action, {
          method: "POST",
          body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>),
        });
        const result = (await response.json().catch(() => null)) as { ok?: boolean; error?: string } | null;
        if (response.ok && result?.ok) {
          form.hidden = true;
          thanks.hidden = false;
          thanks.focus();
        } else {
          fail(result?.error ?? "invalid");
        }
      } catch {
        fail("network");
      } finally {
        button.disabled = false;
        button.textContent = submitLabel;
      }
    });
  }
</script>
