# Content source: the staging relay. Run with `npm run dev:staging-relay`.
# Put the relay's URL and your read key for it in .env.staging-relay.local (git-ignored).
# Both are blank here so a missing .local file stops the build, and so a key from .env.local
# (the production one) is never sent to the staging relay.
CONTENT_RELAY_URL=
CONTENT_RELAY_READ_KEY=
