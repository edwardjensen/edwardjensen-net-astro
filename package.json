{
  "name": "edwardjensen-net-astro",
  "type": "module",
  "version": "14.3.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:production-relay": "astro dev --mode production-relay",
    "dev:staging-relay": "astro dev --mode staging-relay",
    "dev:staging-direct": "astro dev --mode staging-direct",
    "dev:local-cms": "astro dev --mode local-cms",
    "build": "astro build",
    "build:production-relay": "astro build --mode production-relay",
    "build:staging-relay": "astro build --mode staging-relay",
    "build:staging-direct": "astro build --mode staging-direct",
    "build:local-cms": "astro build --mode local-cms",
    "check:source": "node scripts/check-content-source.js",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "a11y": "A11Y_BASE_URL=http://localhost:4321 node scripts/a11y-check.js",
    "a11y:report": "A11Y_BASE_URL=http://localhost:4321 node scripts/a11y-check.js --report"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/preact": "^6.1.1",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.4.2",
    "pa11y": "^10.0.0",
    "preact": "^11.1.0",
    "tailwindcss": "^4.3.0",
    "wrangler": "^4.93.0"
  },
  "overrides": {
    "vite": "^7"
  }
}
